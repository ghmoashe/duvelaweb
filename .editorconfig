# EditorConfig — https://editorconfig.org
# Keep source files UTF-8 (no BOM) so Russian text and emojis in the UI
# strings never get re-encoded to a legacy codepage by an editor.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
